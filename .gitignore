*.pyc

# State never lives in this repo - it defaults to ../.amp (see AMP_HOME).
# These entries are belt-and-braces in case someone points AMP_HOME here.
.amp/
.secrets.json
.board.json
config.json
packets/
rulings/

# Throwaway state for a preview-launched console (see .claude/launch.json).
.amp-preview/

# Server logs from a locally launched console.
.amp-server.log
.server-*.log
